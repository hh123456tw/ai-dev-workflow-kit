{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "deepseek/deepseek-v4-flash",
  "plugin": [
    "@hueyexe/opencode-ensemble@0.18.0"
  ],
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1536,
      "max_height": 1536,
      "max_base64_bytes": 163840
    }
  },
  "provider": {},
  "compaction": {
    "auto": false,
    "prune": true,
    "tail_turns": 2,
    "reserved": 10000
  },
  "mcp": {
    "contexthub": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@aisuite/chub",
        "chub-mcp"
      ],
      "enabled": true
    }
  }
}
