{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "deepseek/deepseek-v4-flash",
  "plugin": [
    "@hueyexe/opencode-ensemble@0.17.0"
  ],
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1536,
      "max_height": 1536,
      "max_base64_bytes": 163840
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:0.5b": {
          "name": "Qwen 2.5 0.5B",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "gemma4:e2b": {
          "name": "Gemma 4 E2B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false,
    "prune": true,
    "tail_turns": 2,
    "reserved": 10000
  },
  "mcp": {
    "contexthub": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@aisuite/chub",
        "chub-mcp"
      ],
      "enabled": true
    }
  }
}
