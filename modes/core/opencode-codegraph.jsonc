{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "core-lead",
  "subagent_depth": 1,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "{env:CODEGRAPH_HOME}/.codegraph/bin/v0.20.1/codegraph-server-win32-x64.exe",
        "--mcp",
        "--profile=core"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}
