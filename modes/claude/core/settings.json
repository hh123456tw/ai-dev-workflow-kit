{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*credentials*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git push*)",
      "PowerShell(git rebase*)",
      "PowerShell(git push*)"
    ]
  },
  "includeCoAuthoredBy": true
}
